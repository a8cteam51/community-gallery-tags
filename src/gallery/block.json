{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "community-gallery-tags/gallery",
	"version": "0.1.0",
	"title": "Community Gallery Tags",
	"category": "media",
	"icon": "format-gallery",
	"description": "Block to display a gallery of photos, and enable visitors to suggest tags.",
	"example": {},
	"supports": {
		"align": [ "center", "wide", "full" ],
		"html": false,
		"multiple": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"textAlign": true
		}
	},
	"attributes": {
		"officialPhotosID": {
			"type": "number"
		},
		"allPhotosText": {
			"type": "string",
			"default": "All Photos"
		},
		"officalPhotosText": {
			"type": "string",
			"default": "Official Photos"
		},
		"communityPhotosText": {
			"type": "string",
			"default": "Community Photos"
		}
	},
	"textdomain": "community-gallery-tags",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
